def models_in_use(endpoint_id: str) -> Optional[int]:
    provider = read_models_document().get("providers", {}).get(endpoint_id)
    return len(provider.get("models", [])) if isinstance(provider, dict) else None


def describe_key(endpoint_id: str) -> str:
    if stored_key(endpoint_id):
        return "key saved"
    if os.environ.get(env_var_for(endpoint_id)):
        return f"key from ${env_var_for(endpoint_id)}"
    return "no key"


def describe_endpoint(endpoint: Endpoint) -> str:
    host = urllib.parse.urlsplit(endpoint["baseUrl"]).netloc
    status = "disabled"
    if endpoint["enabled"]:
        count = models_in_use(endpoint["id"])
        status = "no model list yet; run refresh" if count is None else f"{count} models"
    return f'{endpoint["name"]} [{endpoint["id"]}] - {host} - {status} - {describe_key(endpoint["id"])}'


def cmd_list(_args: argparse.Namespace) -> None:
    endpoints = read_endpoints()
    if not endpoints:
        print("No endpoints yet. Add one with: prime-agent-endpoints add <url>")
    for endpoint in endpoints:
        print(describe_endpoint(endpoint))


def read_key(args: argparse.Namespace, prompt: str) -> Optional[str]:
    """The key from --key-stdin, --key-env or a hidden prompt; None for no key."""
    if getattr(args, "no_key", False):
        return None
    if getattr(args, "key_stdin", False):
        return sys.stdin.readline().strip() or None
    variable = getattr(args, "key_env", None)
    if variable:
        value = os.environ.get(variable, "").strip()
        if not value:
            raise Fail(f"${variable} is not set.")
        return value
    if not sys.stdin.isatty():
        raise Fail("Pass the key with --key-stdin or --key-env NAME (or --no-key when the endpoint needs none).")
    return getpass.getpass(prompt).strip() or None


def after_change(endpoint_id: str, count: int, verb: str) -> None:
    print(f"{verb}: {count} models. Choose one with /model {endpoint_id}; restart Prime Agent or run /reload first if it is running.")


def cmd_add(args: argparse.Namespace) -> None:
    url = args.url or (input("Endpoint URL, usually ending in /v1: ").strip() if sys.stdin.isatty() else "")
    if not url:
        raise Fail("Give the endpoint URL: prime-agent-endpoints add <url>")
    key = read_key(args, "API key (leave empty if the endpoint needs none): ")
    name = args.name
    if name is None and sys.stdin.isatty():
        host = urllib.parse.urlsplit(url).netloc
        name = input(f"Name (leave empty for {host}): ").strip() or None
    endpoint, count = op_add(url, key, name, args.id, args.context_window, args.max_tokens)
    if count == 0:
        print(f'Added {endpoint["name"]} [{endpoint["id"]}], but it lists no models the agent can use.')
    else:
        after_change(endpoint["id"], count, f'Added {endpoint["name"]} [{endpoint["id"]}]')


def cmd_refresh(args: argparse.Namespace) -> None:
    endpoints = read_endpoints()
    if args.id:
        targets = [find_endpoint(endpoints, args.id)]
    else:
        targets = [endpoint for endpoint in endpoints if endpoint["enabled"]]
    failed = False
    for endpoint in targets:
        try:
            count = op_refresh(endpoint)
        except Fail as error:
            failed = True
            print(f'{endpoint["name"]}: {error}', file=sys.stderr)
        else:
            print(f'{endpoint["name"]}: {count} models.')
    if failed:
        raise SystemExit(1)


def cmd_enable(args: argparse.Namespace) -> None:
    op_set_enabled(args.id, True)
    endpoint = find_endpoint(read_endpoints(), args.id)
    try:
        after_change(args.id, op_refresh(endpoint), f'{endpoint["name"]} enabled')
    except Fail as error:
        print(f'{endpoint["name"]} enabled, but its models could not be refreshed: {error}', file=sys.stderr)


def cmd_disable(args: argparse.Namespace) -> None:
    op_set_enabled(args.id, False)
    print(f"{args.id} disabled. Its settings and key are kept; its models are hidden once Prime Agent reloads.")


def cmd_key(args: argparse.Namespace) -> None:
    if args.remove:
        op_set_key(args.id, None)
        print(f"Deleted the saved key for {args.id}.")
        return
    key = read_key(args, f"API key for {args.id}: ")
    if not key:
        raise Fail("No key given. Use --remove to delete the saved key.")
    op_set_key(args.id, key)
    print(f"Saved the key for {args.id}.")
    try:
        print(f'Refreshed: {op_refresh(find_endpoint(read_endpoints(), args.id))} models.')
    except Fail as error:
        print(f"The key is saved, but the models could not be refreshed: {error}", file=sys.stderr)


def cmd_url(args: argparse.Namespace) -> None:
    after_change(args.id, op_set_url(args.id, args.url), f"{args.id} now uses {args.url.rstrip('/')}")


def confirm(question: str) -> bool:
    return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")


def cmd_remove(args: argparse.Namespace) -> None:
    endpoint = find_endpoint(read_endpoints(), args.id)
    if not args.yes:
        if not sys.stdin.isatty():
            raise Fail("Removing deletes the saved key too. Pass --yes to confirm.")
        if not confirm(f'Remove {endpoint["name"]}? Its saved API key is deleted too.'):
            return
    op_remove(args.id)
    print(f'{endpoint["name"]} removed.')


def cmd_update(args: argparse.Namespace) -> None:
    """Replaces this script with the one published beside the installer, after checking its SHA-256."""
    base = os.environ.get("PRIME_AGENT_ENDPOINTS_BASE_URL", DEFAULT_BASE_URL).rstrip("/")
    try:
        sums = http_get(f"{base}/helper/SHA256SUMS").decode("utf-8")
        latest = http_get(f"{base}/helper/{HELPER_NAME}")
    except (urllib.error.URLError, OSError, UnicodeDecodeError) as error:
        raise Fail(f"could not download the helper from {base}: {describe(error)}") from error
    published = {parts[1]: parts[0] for parts in (line.split() for line in sums.splitlines()) if len(parts) == 2}
    if hashlib.sha256(latest).hexdigest() != published.get(HELPER_NAME):
        raise Fail(f"{HELPER_NAME} from {base} does not match its published checksum; nothing was changed.")
    path = os.path.realpath(__file__)
    with open(path, "rb") as handle:
        current = handle.read()
    if current == latest:
        print("Already up to date.")
    elif args.check:
        print("An update is available. Run: prime-agent-endpoints update")
    else:
        write_text_atomically(path, latest.decode("utf-8"))
        print(f"Updated {path}.")


def cmd_sync(_args: argparse.Namespace) -> None:
    counts = sync_models()
    for endpoint_id, count in counts.items():
        print(f"{endpoint_id}: {count} models.")
    missing = [e["id"] for e in read_endpoints() if e["enabled"] and e["id"] not in counts]
    if missing:
        print(f"No model list yet for {', '.join(missing)}; run: prime-agent-endpoints refresh", file=sys.stderr)


def menu() -> None:
    while True:
        endpoints = read_endpoints()
        print("\nEndpoints")
        for number, endpoint in enumerate(endpoints, 1):
            print(f"  {number}) {describe_endpoint(endpoint)}")
        print("  a) Add an endpoint\n  q) Quit")
        choice = input("> ").strip().lower()
        try:
            if choice in ("q", ""):
                return
            if choice == "a":
                args = argparse.Namespace(url=None, name=None, id=None, context_window=None, max_tokens=None)
                cmd_add(args)
            elif choice.isdigit() and 1 <= int(choice) <= len(endpoints):
                manage(endpoints[int(choice) - 1])
            else:
                print("Choose a number, a or q.")
        except Fail as error:
            print(f"error: {error}", file=sys.stderr)


def manage(endpoint: Endpoint) -> None:
    endpoint_id = endpoint["id"]
    toggle = "Disable" if endpoint["enabled"] else "Enable"
    print(f'\n{describe_endpoint(endpoint)}\n  1) {toggle}\n  2) Refresh models\n  3) Change API key\n  4) Change URL\n  5) Remove\n  b) Back')
    choice = input("> ").strip().lower()
    if choice == "1":
        (cmd_disable if endpoint["enabled"] else cmd_enable)(argparse.Namespace(id=endpoint_id))
    elif choice == "2":
        cmd_refresh(argparse.Namespace(id=endpoint_id))
    elif choice == "3":
        cmd_key(argparse.Namespace(id=endpoint_id, remove=False))
    elif choice == "4":
        url = input(f'URL for {endpoint["name"]} [{endpoint["baseUrl"]}]: ').strip()
        if url:
            cmd_url(argparse.Namespace(id=endpoint_id, url=url))
    elif choice == "5":
        cmd_remove(argparse.Namespace(id=endpoint_id, yes=False))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="prime-agent-endpoints",
        description="Manage OpenAI-compatible endpoints for Prime Agent. With no command, opens a menu.",
        epilog="A running Prime Agent may need a restart or /reload before /model shows a change.",
    )
    commands = parser.add_subparsers(dest="command", metavar="command")

    def command(name: str, handler: Any, help_text: str) -> argparse.ArgumentParser:
        sub = commands.add_parser(name, help=help_text, description=help_text)
        sub.set_defaults(handler=handler)
        return sub

    def key_options(sub: argparse.ArgumentParser, with_no_key: bool) -> None:
        group = sub.add_mutually_exclusive_group()
        group.add_argument("--key-stdin", action="store_true", help="read the API key from the first line of stdin")
        group.add_argument("--key-env", metavar="NAME", help="read the API key from this environment variable")
        if with_no_key:
            group.add_argument("--no-key", action="store_true", help="the endpoint needs no key")

    command("list", cmd_list, "list endpoints, their model counts and key status")

    add = command("add", cmd_add, "check an endpoint by listing its models, then add it")
    add.add_argument("url", nargs="?", help="the endpoint URL, usually ending in /v1")
    add.add_argument("--name", help="display name (default: the URL's host)")
    add.add_argument("--id", help="provider id used in /model (default: derived from the name)")
    add.add_argument("--context-window", type=int, metavar="N", help="for models whose context size the endpoint does not report")
    add.add_argument("--max-tokens", type=int, metavar="N", help="for models whose output limit the endpoint does not report")
    key_options(add, with_no_key=True)

    refresh = command("refresh", cmd_refresh, "re-read an endpoint's models (every enabled endpoint without an id)")
    refresh.add_argument("id", nargs="?")

    for name, handler, text in (("enable", cmd_enable, "show an endpoint's models again"), ("disable", cmd_disable, "hide an endpoint's models, keeping its settings and key")):
        sub = command(name, handler, text)
        sub.add_argument("id")

    key = command("key", cmd_key, "save or delete an endpoint's API key")
    key.add_argument("id")
    key.add_argument("--remove", action="store_true", help="delete the saved key")
    key_options(key, with_no_key=False)

    url = command("url", cmd_url, "point an endpoint at another URL")
    url.add_argument("id")
    url.add_argument("url")

    remove = command("remove", cmd_remove, "remove an endpoint and its saved key")
    remove.add_argument("id")
    remove.add_argument("--yes", action="store_true", help="do not ask for confirmation")

    command("sync", cmd_sync, "rebuild models.json from endpoints.json and the cached model lists, without network")

    update = command("update", cmd_update, "replace this helper with the latest published version, after checking its checksum")
    update.add_argument("--check", action="store_true", help="only report whether an update is available")
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command is None:
            if not sys.stdin.isatty():
                cmd_list(args)
                return 0
            menu()
        else:
            args.handler(args)
    except Fail as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    except (KeyboardInterrupt, EOFError):
        print(file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
