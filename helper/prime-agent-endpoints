#!/usr/bin/env python3
"""Manage OpenAI-compatible endpoints for Prime Agent.

Prime Agent has no extension API from v0.10.0 on, so this helper does what the
/endpoints extension did through the one extension point that remains:
~/.prime/agent/models.json.

  endpoints.json       the endpoints you manage (id, name, URL, enabled); edit by hand if you like
  endpoints/<id>.models.json
                       each endpoint's model list as the server last reported it
  models.json          a provider block per enabled endpoint, generated from the two above;
                       other providers in the file are left alone
  auth.json            API keys, in Prime Agent's credential store, so /login and /logout work

Run it with no arguments for a menu, or see `prime-agent-endpoints --help`.
A running Prime Agent reads models.json when it refreshes its model list: restart it, or run
/reload, if a change is not in /model yet.
"""

from __future__ import annotations

import argparse
import contextlib
import getpass
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from typing import Any, Dict, Iterator, List, Optional, Tuple

# What Prime Agent uses for custom models that leave these out.
DEFAULT_CONTEXT_WINDOW = 128_000
DEFAULT_MAX_TOKENS = 16_384
CATALOG_TIMEOUT_S = 10
HELPER_NAME = "prime-agent-endpoints"
DEFAULT_BASE_URL = "https://sirouk.github.io/prime-agent"
ID_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
THINKING_LEVELS = ("minimal", "low", "medium", "high", "xhigh", "max")

# Provider ids Prime Agent ships models for. An endpoint with one of these ids would
# override the built-in provider instead of adding a new one.
BUILT_IN_PROVIDERS = frozenset(
    """amazon-bedrock anthropic azure-openai-responses cerebras cloudflare-ai-gateway
    cloudflare-workers-ai deepseek fireworks github-copilot google google-vertex groq
    huggingface kimi-coding minimax minimax-cn mistral moonshotai moonshotai-cn openai
    openai-codex opencode opencode-go openrouter prime-inference vercel-ai-gateway xai
    xiaomi xiaomi-token-plan-ams xiaomi-token-plan-cn xiaomi-token-plan-sgp zai""".split()
)


class Fail(Exception):
    """A problem to report to the user, without a traceback."""


# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------


def agent_dir() -> str:
    path = os.environ.get("PRIME_AGENT_CODING_AGENT_DIR") or os.path.join("~", ".prime", "agent")
    return os.path.abspath(os.path.expanduser(path))


def endpoints_path() -> str:
    return os.path.join(agent_dir(), "endpoints.json")


def models_path() -> str:
    return os.path.join(agent_dir(), "models.json")


def auth_path() -> str:
    return os.path.join(agent_dir(), "auth.json")


def cache_path(endpoint_id: str) -> str:
    return os.path.join(agent_dir(), "endpoints", f"{endpoint_id}.models.json")


def strip_json_comments(text: str) -> str:
    """Prime Agent reads models.json with // comments and trailing commas allowed."""
    without_comments: List[str] = []
    in_string = escaped = False
    i = 0
    while i < len(text):
        char = text[i]
        if in_string:
            without_comments.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
            without_comments.append(char)
        elif char == "/" and text[i + 1 : i + 2] == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        else:
            without_comments.append(char)
        i += 1

    cleaned: List[str] = []
    in_string = escaped = False
    chars = "".join(without_comments)
    i = 0
    while i < len(chars):
        char = chars[i]
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
        elif char == ",":
            j = i + 1
            while j < len(chars) and chars[j].isspace():
                j += 1
            if j < len(chars) and chars[j] in "}]":
                i += 1
                continue
        cleaned.append(char)
        i += 1
    return "".join(cleaned)


def read_json(path: str, lenient: bool = False) -> Optional[Any]:
    """The parsed file, or None when it does not exist. A malformed file fails with its path."""
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except FileNotFoundError:
        return None
    try:
        return json.loads(strip_json_comments(text) if lenient else text)
    except json.JSONDecodeError as error:
        raise Fail(f"{path}: {error}") from error


def write_text_atomically(path: str, text: str, mode: Optional[int] = None) -> None:
    """Writes beside the target and renames, so a reader never sees half a file."""
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    if mode is None:
        try:
            mode = os.stat(path).st_mode & 0o777
        except FileNotFoundError:
            mode = 0o644
    handle, temporary = tempfile.mkstemp(dir=directory, prefix=f".{os.path.basename(path)}.", suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(text)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)
        raise


def write_json_atomically(path: str, value: Any, mode: Optional[int] = None) -> None:
    write_text_atomically(path, json.dumps(value, indent=2, ensure_ascii=False) + "\n", mode)


# ---------------------------------------------------------------------------
# Saved endpoints
# ---------------------------------------------------------------------------

Endpoint = Dict[str, Any]


def is_http_url(value: str) -> bool:
    parsed = urllib.parse.urlsplit(value)
    return parsed.scheme in ("http", "https") and bool(parsed.netloc)


def parse_endpoint(value: Any, where: str) -> Endpoint:
    entry = value if isinstance(value, dict) else {}
    endpoint_id = entry.get("id")
    if not isinstance(endpoint_id, str) or not ID_PATTERN.match(endpoint_id):
        raise Fail(f'{where}: "id" must be lowercase letters, digits and single dashes')
    name = entry.get("name")
    if not isinstance(name, str) or not name.strip():
        raise Fail(f'{where}: "name" is required')
    base_url = entry.get("baseUrl")
    if not isinstance(base_url, str) or not is_http_url(base_url):
        raise Fail(f'{where}: "baseUrl" must be an http or https URL')
    enabled = entry.get("enabled", True)
    if not isinstance(enabled, bool):
        raise Fail(f'{where}: "enabled" must be true or false')
    endpoint: Endpoint = {
        "id": endpoint_id,
        "name": name.strip(),
        "baseUrl": base_url.rstrip("/"),
        "enabled": enabled,
    }
    for limit_name in ("contextWindow", "maxTokens"):
        if limit_name not in entry:
            continue
        limit = entry[limit_name]
        if isinstance(limit, bool) or not isinstance(limit, int) or limit <= 0:
            raise Fail(f'{where}: "{limit_name}" must be a positive whole number')
        endpoint[limit_name] = limit
    return endpoint


def read_endpoints() -> List[Endpoint]:
    path = endpoints_path()
    document = read_json(path)
    if document is None:
        return []
    if not isinstance(document, dict) or not isinstance(document.get("endpoints"), list):
        raise Fail(f'{path}: "endpoints" must be a list')
    endpoints = [parse_endpoint(value, f"{path}: endpoints[{index}]") for index, value in enumerate(document["endpoints"])]
    seen = set()
    for endpoint in endpoints:
        if endpoint["id"] in seen:
            raise Fail(f'{path}: the id "{endpoint["id"]}" is used twice')
        seen.add(endpoint["id"])
    return endpoints


def write_endpoints(endpoints: List[Endpoint]) -> None:
    write_json_atomically(endpoints_path(), {"endpoints": endpoints})


def find_endpoint(endpoints: List[Endpoint], endpoint_id: str) -> Endpoint:
    for endpoint in endpoints:
        if endpoint["id"] == endpoint_id:
            return endpoint
    known = ", ".join(endpoint["id"] for endpoint in endpoints) or "none yet"
    raise Fail(f'No endpoint "{endpoint_id}". Endpoints: {known}.')


# ---------------------------------------------------------------------------
# Keys: Prime Agent's auth.json, under the lock Prime Agent itself takes
# ---------------------------------------------------------------------------

LOCK_STALE_S = 10
LOCK_ATTEMPTS = 100
LOCK_RETRY_S = 0.02


@contextlib.contextmanager
def auth_lock() -> Iterator[None]:
    """The `auth.json.lock` directory, the convention Prime Agent's credential store uses."""
    os.makedirs(agent_dir(), exist_ok=True)
    lock = auth_path() + ".lock"
    for _ in range(LOCK_ATTEMPTS):
        try:
            os.mkdir(lock)
            break
        except FileExistsError:
            try:
                if time.time() - os.stat(lock).st_mtime > LOCK_STALE_S:
                    with contextlib.suppress(OSError):
                        os.rmdir(lock)
                    continue
            except FileNotFoundError:
                continue
            time.sleep(LOCK_RETRY_S)
    else:
        raise Fail(f"Could not lock {auth_path()}; is another Prime Agent writing it?")
    try:
        yield
    finally:
        with contextlib.suppress(OSError):
            os.rmdir(lock)


def read_auth() -> Dict[str, Any]:
    document = read_json(auth_path())
    if document is None:
        return {}
    if not isinstance(document, dict):
        raise Fail(f"{auth_path()}: expected a JSON object")
    return document


def stored_key(endpoint_id: str) -> Optional[str]:
    credential = read_auth().get(endpoint_id)
    if isinstance(credential, dict) and credential.get("type") == "api_key":
        key = credential.get("key")
        return key if isinstance(key, str) and key else None
    return None


def save_key(endpoint_id: str, key: Optional[str]) -> None:
    """Stores the key, or deletes the saved key when `key` is None."""
    with auth_lock():
        document = read_auth()
        if key is None:
            document.pop(endpoint_id, None)
        else:
            document[endpoint_id] = {"type": "api_key", "key": key}
        write_json_atomically(auth_path(), document, mode=0o600)


def env_var_for(endpoint_id: str) -> str:
    """The environment variable that can also hold a key: TOGETHER_API_KEY for "together"."""
    return endpoint_id.upper().replace("-", "_") + "_API_KEY"


def key_for(endpoint_id: str) -> Optional[str]:
    return stored_key(endpoint_id) or os.environ.get(env_var_for(endpoint_id)) or None


# ---------------------------------------------------------------------------
# Fetching models
# ---------------------------------------------------------------------------

CatalogEntry = Dict[str, Any]


class _SameHostRedirects(urllib.request.HTTPRedirectHandler):
    """Never forwards the API key to another host."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # type: ignore[no-untyped-def]
        if urllib.parse.urlsplit(newurl).netloc != urllib.parse.urlsplit(req.full_url).netloc:
            raise urllib.error.HTTPError(req.full_url, code, f"redirected to another host ({newurl})", headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


_opener = urllib.request.build_opener(_SameHostRedirects)


def describe(error: BaseException) -> str:
    if isinstance(error, urllib.error.URLError) and isinstance(error.reason, BaseException):
        return str(error.reason)
    return str(error) or error.__class__.__name__


def http_get(url: str, api_key: Optional[str] = None) -> bytes:
    headers = {"User-Agent": "prime-agent-endpoints"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    request = urllib.request.Request(url, headers=headers)
    with _opener.open(request, timeout=CATALOG_TIMEOUT_S) as response:
        return response.read()


def http_get_json(url: str, api_key: Optional[str]) -> Any:
    return json.loads(http_get(url, api_key).decode("utf-8"))


def parse_catalog(payload: Any) -> List[CatalogEntry]:
    data = payload.get("data") if isinstance(payload, dict) else None
    if not isinstance(data, list):
        raise Fail("the response is not an OpenAI-compatible model list")
    return [entry for entry in data if isinstance(entry, dict) and isinstance(entry.get("id"), str)]


def fetch_model_list(base_url: str, api_key: Optional[str]) -> List[CatalogEntry]:
    url = f"{base_url}/models"
    try:
        return parse_catalog(http_get_json(url, api_key))
    except urllib.error.HTTPError as error:
        error.close()
        if error.code in (401, 403):
            raise Fail(f"{url} refused the API key (HTTP {error.code})") from error
        if 300 <= error.code < 400:
            raise Fail(f"{url} {error.msg}") from error
        raise Fail(f"{url} answered HTTP {error.code}") from error
    except (urllib.error.URLError, OSError) as error:
        raise Fail(f"could not reach {url}: {describe(error)}") from error
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise Fail(f"{url}: not JSON ({error})") from error
    except Fail as error:
        raise Fail(f"{url}: {error}") from error


# Fields of an Unsloth `GET /status` that describe the loaded model(s).
STATUS_FIELDS = (
    "supports_reasoning",
    "reasoning_style",
    "reasoning_effort_levels",
    "reasoning_always_on",
    "context_length",
)


def merge_status(entries: List[CatalogEntry], status: Any) -> List[CatalogEntry]:
    """Unsloth's /models omits reasoning and context details that /status reports for the loaded model."""
    report = status if isinstance(status, dict) else {}
    loaded = set(strings(report.get("loaded")))
    metadata = {key: report[key] for key in STATUS_FIELDS if key in report}
    if not loaded or not metadata:
        return entries
    return [{**entry, **metadata} if entry["id"] in loaded else entry for entry in entries]


def fetch_status(base_url: str, api_key: Optional[str]) -> Any:
    """The server's /status when it has one, else None so discovery uses /models alone."""
    try:
        return http_get_json(f"{base_url}/status", api_key)
    except urllib.error.HTTPError as error:
        error.close()
        return None
    except (urllib.error.URLError, OSError, ValueError):
        return None


def fetch_catalog(base_url: str, api_key: Optional[str]) -> List[CatalogEntry]:
    entries = fetch_model_list(base_url, api_key)
    return merge_status(entries, fetch_status(base_url, api_key))


def read_cached_catalog(endpoint_id: str) -> Optional[List[CatalogEntry]]:
    try:
        document = read_json(cache_path(endpoint_id))
        return parse_catalog(document) if document is not None else None
    except Fail:
        # An unreadable cache is the same as none; refresh rewrites it.
        return None


# ---------------------------------------------------------------------------
# Catalog entry -> models.json model
# ---------------------------------------------------------------------------


def positive(value: Any) -> Optional[float]:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return value if value > 0 and value == value and value != float("inf") else None


def strings(value: Any) -> List[str]:
    return [item for item in value if isinstance(item, str)] if isinstance(value, list) else []


def field(entry: CatalogEntry, parent: str, key: str) -> Any:
    container = entry.get(parent)
    return container.get(key) if isinstance(container, dict) else None


def stated_reasoning(entry: CatalogEntry) -> Optional[bool]:
    """`supports_reasoning`, `reasoning: true` or `reasoning: {supported: true}`; an explicit false wins."""
    stated = [
        value
        for value in (entry.get("supports_reasoning"), entry.get("reasoning"), field(entry, "reasoning", "supported"))
        if isinstance(value, bool)
    ]
    if False in stated:
        return False
    return True if True in stated else None


def thinking_level_map(effort_levels: List[str], always_on: bool) -> Dict[str, Optional[str]]:
    """Maps Prime Agent's thinking levels onto the efforts a server lists; the others are hidden (null)."""
    mapped: Dict[str, Optional[str]] = {"off": None if always_on else "none"}
    for level in THINKING_LEVELS:
        mapped[level] = level if level in effort_levels else None
    return mapped


def supports_tools(entry: CatalogEntry) -> bool:
    """False for a model the endpoint says cannot call tools, which Prime Agent works through."""
    # Chutes lists capabilities in supported_features, OpenRouter in supported_parameters.
    capabilities = strings(entry.get("supported_features")) + strings(entry.get("supported_parameters"))
    return not capabilities or "tools" in capabilities


def thinking_traits(entry: CatalogEntry) -> Tuple[bool, List[str], bool]:
    """(reasoning, listed effort levels, whether the server also needs enable_thinking)."""
    capabilities = strings(entry.get("supported_features")) + strings(entry.get("supported_parameters"))
    reasoning = stated_reasoning(entry)
    if reasoning is None:
        reasoning = "reasoning" in capabilities
    # Effort levels are stated flat (Unsloth: reasoning_effort_levels) or nested (reasoning.levels).
    levels = strings(entry.get("reasoning_effort_levels")) + strings(field(entry, "reasoning", "levels"))
    gated = reasoning and entry.get("reasoning_style") == "enable_thinking_effort"
    return reasoning, levels, gated


def to_model(entry: CatalogEntry, endpoint: Endpoint) -> Optional[Dict[str, Any]]:
    """The models.json model for a catalog entry, or None for one that cannot call tools."""
    if not supports_tools(entry):
        return None
    context_window = int(
        positive(entry.get("context_length"))
        or positive(entry.get("max_model_len"))
        or endpoint.get("contextWindow")
        or DEFAULT_CONTEXT_WINDOW
    )
    output_limit = int(
        positive(entry.get("max_output_length"))
        or positive(entry.get("max_output_tokens"))
        or positive(field(entry, "top_provider", "max_completion_tokens"))
        or endpoint.get("maxTokens")
        or DEFAULT_MAX_TOKENS
    )
    inputs = strings(entry.get("input_modalities")) + strings(field(entry, "architecture", "input_modalities"))
    reasoning, levels, gated = thinking_traits(entry)
    name = next((v.strip() for v in (entry.get("name"), entry.get("display_name")) if isinstance(v, str) and v.strip()), None)

    model: Dict[str, Any] = {
        "id": entry["id"],
        "name": name or entry["id"],
        "reasoning": reasoning,
        "input": ["text", "image"] if "image" in inputs else ["text"],
        # Endpoints report prices in different units, so usage is not priced.
        "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
        "contextWindow": context_window,
        "maxTokens": min(output_limit, context_window),
    }
    if reasoning and levels and not gated:
        model["thinkingLevelMap"] = thinking_level_map(levels, entry.get("reasoning_always_on") is True)
    return model


def provider_compat(entries: List[CatalogEntry]) -> Dict[str, Any]:
    """Request settings for the whole endpoint: Prime Agent takes `compat` from the provider only.

    The base is the broadly supported shape: a system message, max_tokens, no store. Models that
    list effort levels get reasoning_effort. A server that wants enable_thinking next to
    reasoning_effort gets the enable_thinking toggle alone, because Prime Agent has no
    per-request hook: thinking on or off, no level. Where an endpoint has both kinds of
    model, effort levels win.
    """
    compat: Dict[str, Any] = {"supportsStore": False, "supportsDeveloperRole": False, "maxTokensField": "max_tokens"}
    traits = [thinking_traits(entry) for entry in entries if supports_tools(entry)]
    if any(reasoning and levels and not gated for reasoning, levels, gated in traits):
        compat["supportsReasoningEffort"] = True
    elif any(gated for _, _, gated in traits):
        compat["thinkingFormat"] = "qwen"
    return compat


def provider_block(endpoint: Endpoint, entries: List[CatalogEntry]) -> Dict[str, Any]:
    models = [model for model in (to_model(entry, endpoint) for entry in entries) if model]
    return {
        "name": endpoint["name"],
        "baseUrl": endpoint["baseUrl"],
        "api": "openai-completions",
        # A key saved in auth.json wins over this. With no saved key and the variable unset, its
        # name is sent as the key: endpoints that need none ignore it, the rest reject it.
        "apiKey": env_var_for(endpoint["id"]),
        "compat": provider_compat(entries),
        "models": models,
    }


# ---------------------------------------------------------------------------
# models.json
# ---------------------------------------------------------------------------


def read_models_document() -> Dict[str, Any]:
    document = read_json(models_path(), lenient=True)
    if document is None:
        return {}
    if not isinstance(document, dict) or not isinstance(document.get("providers", {}), dict):
        raise Fail(f'{models_path()}: "providers" must be an object')
    return document


def write_models_document(document: Dict[str, Any]) -> None:
    path = models_path()
    backup = path + ".before-endpoints"
    # The file is rewritten as plain JSON, which drops comments: keep the original once.
    if os.path.exists(path) and not os.path.exists(backup):
        shutil.copy2(path, backup)
    write_json_atomically(path, document, mode=None if os.path.exists(path) else 0o600)


def sync_models(removed: Tuple[str, ...] = ()) -> Dict[str, int]:
    """Regenerates the provider block of every enabled endpoint from its cached model list.

    Providers of removed or disabled endpoints are deleted; every other provider is untouched.
    Returns the model count per synced endpoint.
    """
    endpoints = read_endpoints()
    document = read_models_document()
    before = json.dumps(document, sort_keys=True)
    providers: Dict[str, Any] = document.setdefault("providers", {})
    counts: Dict[str, int] = {}
    for endpoint_id in removed:
        providers.pop(endpoint_id, None)
    for endpoint in endpoints:
        entries = read_cached_catalog(endpoint["id"])
        if not endpoint["enabled"]:
            providers.pop(endpoint["id"], None)
        elif entries is not None:
            block = provider_block(endpoint, entries)
            providers[endpoint["id"]] = block
            counts[endpoint["id"]] = len(block["models"])
    if not providers and "providers" not in json.loads(before):
        del document["providers"]
    if json.dumps(document, sort_keys=True) != before:
        write_models_document(document)
    return counts


def check_id_available(endpoint_id: str, endpoints: List[Endpoint]) -> None:
    if any(endpoint["id"] == endpoint_id for endpoint in endpoints):
        raise Fail(f'"{endpoint_id}" is already one of your endpoints; choose another name.')
    if endpoint_id in BUILT_IN_PROVIDERS:
        raise Fail(f'"{endpoint_id}" is a built-in provider in Prime Agent; choose another name.')
    if endpoint_id in read_models_document().get("providers", {}):
        raise Fail(f'"{endpoint_id}" is already a provider in {models_path()}; choose another name.')
    credential = read_auth().get(endpoint_id)
    if credential is not None and not (isinstance(credential, dict) and credential.get("type") == "api_key"):
        raise Fail(f'"{endpoint_id}" already has a sign-in saved in Prime Agent; choose another name.')


def slugify(name: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------


def op_add(
    url: str,
    key: Optional[str],
    name: Optional[str] = None,
    endpoint_id: Optional[str] = None,
    context_window: Optional[int] = None,
    max_tokens: Optional[int] = None,
) -> Tuple[Endpoint, int]:
    if not is_http_url(url):
        raise Fail(f'"{url}" is not an http or https URL.')
    base_url = url.rstrip("/")
    try:
        entries = fetch_catalog(base_url, key)
    except Fail as error:
        raise Fail(f"Not added: {error}") from error
    name = (name or "").strip() or urllib.parse.urlsplit(base_url).netloc
    endpoint_id = endpoint_id or slugify(name)
    if not ID_PATTERN.match(endpoint_id):
        raise Fail(f'"{endpoint_id}" is not a valid id: use lowercase letters, digits and single dashes.')
    endpoints = read_endpoints()
    check_id_available(endpoint_id, endpoints)
    endpoint: Endpoint = {"id": endpoint_id, "name": name, "baseUrl": base_url, "enabled": True}
    if context_window:
        endpoint["contextWindow"] = context_window
    if max_tokens:
        endpoint["maxTokens"] = max_tokens

    write_json_atomically(cache_path(endpoint_id), {"refreshedAt": int(time.time() * 1000), "data": entries})
    if key:
        save_key(endpoint_id, key)
    write_endpoints(endpoints + [endpoint])
    sync_models()
    return endpoint, sum(1 for entry in entries if to_model(entry, endpoint))


def op_refresh(endpoint: Endpoint) -> int:
    """Fetches the endpoint's models into its cache and regenerates models.json."""
    entries = fetch_catalog(endpoint["baseUrl"], key_for(endpoint["id"]))
    write_json_atomically(cache_path(endpoint["id"]), {"refreshedAt": int(time.time() * 1000), "data": entries})
    sync_models()
    return sum(1 for entry in entries if to_model(entry, endpoint))


def op_set_enabled(endpoint_id: str, enabled: bool) -> None:
    endpoints = read_endpoints()
    find_endpoint(endpoints, endpoint_id)["enabled"] = enabled
    write_endpoints(endpoints)
    sync_models()


def op_set_key(endpoint_id: str, key: Optional[str]) -> None:
    find_endpoint(read_endpoints(), endpoint_id)
    save_key(endpoint_id, key)


def op_set_url(endpoint_id: str, url: str) -> int:
    if not is_http_url(url):
        raise Fail(f'"{url}" is not an http or https URL.')
    endpoints = read_endpoints()
    endpoint = find_endpoint(endpoints, endpoint_id)
    base_url = url.rstrip("/")
    try:
        entries = fetch_catalog(base_url, key_for(endpoint_id))
    except Fail as error:
        raise Fail(f"URL not changed: {error}") from error
    endpoint["baseUrl"] = base_url
    write_json_atomically(cache_path(endpoint_id), {"refreshedAt": int(time.time() * 1000), "data": entries})
    write_endpoints(endpoints)
    sync_models()
    return sum(1 for entry in entries if to_model(entry, endpoint))


def op_remove(endpoint_id: str) -> None:
    endpoints = read_endpoints()
    find_endpoint(endpoints, endpoint_id)
    write_endpoints([endpoint for endpoint in endpoints if endpoint["id"] != endpoint_id])
    if stored_key(endpoint_id):
        save_key(endpoint_id, None)
    with contextlib.suppress(FileNotFoundError):
        os.unlink(cache_path(endpoint_id))
    sync_models(removed=(endpoint_id,))


